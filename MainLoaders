local page1Toggles = {}

local function makeToggle1(text, y, callback)
	local btn = Instance.new("TextButton")
	btn.Parent = Page1Frame
	btn.Size = UDim2.new(1, -20, 0, 32)
	btn.Position = UDim2.new(0, 10, 0, y)
	btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 14
	btn.Text = text .. " : OFF"
	local state = false
	btn.MouseButton1Click:Connect(function()
		state = not state
		btn.Text = text .. " : " .. (state and "ON" or "OFF")
		callback(state)
	end)
	page1Toggles[text] = function() return state end
	return btn
end

makeToggle1("Item Farm", 10, function(v)
	farmItems = v
	if v then task.spawn(farm) end
end)

makeToggle1("Click Spam", 50, function(v)
	clickSpam = v
	clickLoopId += 1
	if v then task.spawn(fireAllClicks, clickLoopId) end
end)

makeToggle1("Ghost Cam", 90, function(v)
	ghostCam = v
	if v then
		startPos = hrp.CFrame
		startCam = cam.CFrame
		cam.CameraType = Enum.CameraType.Scriptable
		cam.CFrame = startCam
	else
		cam.CameraType = Enum.CameraType.Custom
		if startPos then hrp.CFrame = startPos end
	end
end)

makeToggle1("Telekinesis", 130, function(v)
	telekinesis1 = v
	if v then
		noclipConnection = RunService.Stepped:Connect(noclipLoop)
	else
		if noclipConnection then noclipConnection:Disconnect() end
	end
end)

makeToggle1("ESP", 170, function(v)
	espEnabled = v
	if v then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= p and plr.Character then
				espOn(plr, plr.Character)
			end
			plr.CharacterAdded:Connect(function(c)
				if espEnabled then
					task.wait(1)
					espOn(plr, c)
				end
			end)
		end
	else
		espOff()
	end
end)

