-- ==================== PAGE 1 FUNCTIONS ====================
local function espOn(plr, char)
	if plr == p then return end
	local head = char:FindFirstChild("Head")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not head or not hum then return end
	local text = Drawing.new("Text")
	text.Visible = false
	text.Center = true
	text.Outline = false
	text.Font = 3
	text.Size = 16
	text.Color = Color3.fromRGB(170,170,170)
	local con
	con = RunService.RenderStepped:Connect(function()
		if not espEnabled then
			text.Visible = false
			return
		end
		if not char or not char.Parent then
			text:Remove()
			con:Disconnect()
			return
		end
		local pos, vis = cam:WorldToViewportPoint(head.Position)
		if vis then
			local hp = math.floor(hum.Health)
			local maxhp = math.floor(hum.MaxHealth)
			text.Position = Vector2.new(pos.X, pos.Y - 25)
			text.Text = "[ " .. plr.Name .. " | " .. hp .. "/" .. maxhp .. " HP ]"
			text.Visible = true
		else
			text.Visible = false
		end
	end)
	espObjects[plr] = text
	espConnections[plr] = con
end

local function espOff()
	for _, obj in pairs(espObjects) do
		pcall(function()
			obj:Remove()
		end)
	end
	for _, con in pairs(espConnections) do
		pcall(function()
			con:Disconnect()
		end)
	end
	table.clear(espObjects)
	table.clear(espConnections)
end

local function register1(v)
	if v:IsA("ClickDetector") then
		v.MaxActivationDistance = math.huge
		clickDetectors[#clickDetectors+1] = v
	end
	if v.Name == "ItemPickupScript" or v.Name == "NewItemPickupScript" then
		local parent = v.Parent
		if parent then
			local part = parent:IsA("BasePart") and parent or parent:FindFirstChildWhichIsA("BasePart")
			if part then
				pickupParts[#pickupParts+1] = part
			end
		end
	end
end

for _,v in ipairs(Workspace:GetDescendants()) do
	register1(v)
end

Workspace.DescendantAdded:Connect(register1)

local function fireAllClicks(id)
	while clickSpam and id == clickLoopId do
		for i = 1, #clickDetectors do
			local d = clickDetectors[i]
			if d then
				fireclickdetector(d)
			end
		end
		RunService.Heartbeat:Wait()
	end
end

local function farm()
	while farmItems do
		for i = 1, #pickupParts do
			if not farmItems then break end
			local part = pickupParts[i]
			if part and part.Parent then
				hrp.CFrame = part.CFrame + Vector3.new(0,3,0)
				local click = part:FindFirstChildOfClass("ClickDetector")
				if click then
					fireclickdetector(click)
					fireclickdetector(click)
				end
				RunService.Heartbeat:Wait()
			end
		end
	end
end

local function noclipLoop()
	for _,v in ipairs(character:GetChildren()) do
		if v:IsA("BasePart") then
			v.CanCollide = false
		end
	end
end

-- ==================== PAGE 2 FUNCTIONS ====================
local function getGroundY(pos, ignoreList)
	local origin = pos + Vector3.new(0, 200, 0)
	local direction = Vector3.new(0, -500, 0)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = ignoreList or {}
	local result = Workspace:Raycast(origin, direction, params)
	if result then
		return result.Position.Y
	end
	return pos.Y
end

local function createBP(part)
	local bp = Instance.new("BodyPosition")
	bp.MaxForce = Vector3.new(1e8, 1e8, 1e8)
	bp.P = 5e4
	bp.D = 500
	bp.Parent = part
	return bp
end

local function register2(v)
	if v:IsA("BasePart") and not v.Anchored then
		table.insert(tkParts, v)
		if invisibleMode then
			if hiddenParts[v] == nil then
				hiddenParts[v] = v.Transparency
			end
			v.Transparency = 1
		end
	end
end

for _, v in ipairs(Workspace:GetDescendants()) do
	register2(v)
end

Workspace.DescendantAdded:Connect(register2)

local function clearTK()
	for part, bp in pairs(bodyPositions) do
		if bp then bp:Destroy() end
	end
	table.clear(bodyPositions)
end

local function setInvisible(state)
	if state then
		for _, part in ipairs(tkParts) do
			if part and part.Parent and not part.Anchored and not part:IsDescendantOf(character) then
				if hiddenParts[part] == nil then
					hiddenParts[part] = part.Transparency
				end
				part.Transparency = 1
			end
		end
	else
		for part, transparency in pairs(hiddenParts) do
			if part and part.Parent then
				part.Transparency = transparency
			end
		end
		table.clear(hiddenParts)
	end
end

-- ==================== TELEKINESIS SHARED ====================
RunService.RenderStepped:Connect(function(dt)
	if not hrp then return end
	orbitAngle += dt * ORBIT_SPEED

	-- PAGE 1 TELEKINESIS
	if telekinesis1 then
		local playerPos = hrp.Position
		local targetPos = cam.CFrame * CFrame.new(0,0,-DISTANCE)
		for i = 1, #tkParts do
			local part = tkParts[i]
			if part and part.Parent and not part:IsDescendantOf(character) then
				local dist = (part.Position - playerPos).Magnitude
				if dist <= PICKUP_RADIUS then
					local bp = bodyPositions[part]
					if not bp then
						bp = createBP(part)
						bodyPositions[part] = bp
					end
					bp.Position = targetPos.Position
				end
			end
		end
	end

	-- PAGE 2 FLOAT MODE
	if floatMode then
		for _, model in ipairs(Workspace:GetChildren()) do
			if model:IsA("Model")
				and model ~= character
				and model:FindFirstChildOfClass("Humanoid")
				and model:FindFirstChild("HumanoidRootPart") then
				local root = model.HumanoidRootPart
				if (root.Position - hrp.Position).Magnitude <= PICKUP_RADIUS then
					local bp = bodyPositions[root]
					if not bp then
						bp = createBP(root)
						bodyPositions[root] = bp
					end
					local groundY = getGroundY(root.Position, {character})
					local lift = math.clamp(DISTANCE, 0, 5)
					bp.Position = Vector3.new(
						root.Position.X,
						groundY + lift,
						root.Position.Z
					)
				end
			end
		end
	end

	-- PAGE 2 ORBIT MODE
	if orbitMode then
		local nearby = {}
		for _, part in ipairs(tkParts) do
			if part and part.Parent and not part.Anchored and not part:IsDescendantOf(character) then
				if (part.Position - hrp.Position).Magnitude <= PICKUP_RADIUS then
					table.insert(nearby, part)
				end
			end
		end
		local count = #nearby
		for i, part in ipairs(nearby) do
			local bp = bodyPositions[part]
			if not bp then
				bp = createBP(part)
				bodyPositions[part] = bp
			end
			local angle = orbitAngle + ((math.pi * 2) / math.max(count, 1)) * i
			local offset = Vector3.new(
				math.cos(angle) * DISTANCE,
				3,
				math.sin(angle) * DISTANCE
			)
			bp.Position = hrp.Position + offset
		end
	end

	-- PAGE 2 TELEKINESIS
	if telekinesis2 then
		local targetPos = cam.CFrame * CFrame.new(0, 0, -DISTANCE)
		for i = 1, #tkParts do
			local part = tkParts[i]
			if part and part.Parent and not part:IsDescendantOf(character) then
				if (part.Position - hrp.Position).Magnitude <= PICKUP_RADIUS then
					local bp = bodyPositions[part]
					if not bp then
						bp = createBP(part)
						bodyPositions[part] = bp
					end
					bp.Position = targetPos.Position
				end
			end
		end
	end

	-- CLEANUP
	for part, bp in pairs(bodyPositions) do
		if not part.Parent or (part.Position - hrp.Position).Magnitude > PICKUP_RADIUS then
			bp:Destroy()
			bodyPositions[part] = nil
		end
	end
	if not telekinesis1 and not floatMode and not orbitMode and not telekinesis2 then
		clearTK()
	end
end)

